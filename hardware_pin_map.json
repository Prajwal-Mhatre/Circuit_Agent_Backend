{
  "project": "Plant Watering System",
  "description": "An automated system that waters plants based on soil moisture levels using a microcontroller, sensors, and a pump.",
  "components": [
    {
      "name": "Arduino_Uno",
      "pins": [
        "D2",
        "D3",
        "GND",
        "5V"
      ],
      "type": "custom_IC"
    },
    {
      "name": "Soil Moisture Sensor",
      "pins": [
        "A0",
        "GND",
        "5V"
      ],
      "type": "custom_IC"
    },
    {
      "name": "Water Pump",
      "pins": [
        "VCC",
        "GND",
        "D4"
      ],
      "type": "motor"
    },
    {
      "name": "Relay Module",
      "pins": [
        "IN1",
        "GND",
        "VCC"
      ],
      "type": "relay"
    },
    {
      "name": "Power Supply",
      "pins": [
        "VCC",
        "GND"
      ],
      "type": "custom_IC"
    },
    {
      "name": "Water Tubing",
      "pins": [],
      "type": "custom_IC"
    }
  ],
  "connections": [
    {
      "from_": [
        "Arduino_Uno",
        "D2"
      ],
      "to": [
        "Relay Module",
        "IN1"
      ]
    },
    {
      "from_": [
        "Soil Moisture Sensor",
        "A0"
      ],
      "to": [
        "Arduino_Uno",
        "D3"
      ]
    },
    {
      "from_": [
        "Relay Module",
        "GND"
      ],
      "to": [
        "Power Supply",
        "GND"
      ]
    },
    {
      "from_": [
        "Relay Module",
        "VCC"
      ],
      "to": [
        "Power Supply",
        "VCC"
      ]
    },
    {
      "from_": [
        "Water Pump",
        "GND"
      ],
      "to": [
        "Power Supply",
        "GND"
      ]
    },
    {
      "from_": [
        "Water Pump",
        "VCC"
      ],
      "to": [
        "Relay Module",
        "IN1"
      ]
    },
    {
      "from_": [
        "Arduino_Uno",
        "GND"
      ],
      "to": [
        "Power Supply",
        "GND"
      ]
    },
    {
      "from_": [
        "Arduino_Uno",
        "5V"
      ],
      "to": [
        "Soil Moisture Sensor",
        "5V"
      ]
    },
    {
      "from_": [
        "Arduino_Uno",
        "5V"
      ],
      "to": [
        "Relay Module",
        "VCC"
      ]
    }
  ]
}